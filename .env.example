[TEMPLATE]
# Public browser-safe values only
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Canonical/social origin — bake the production domain into og:image, og:url and
# canonical links at build time (e.g. https://feroce.com). When unset, the app
# falls back to the deployed origin at runtime.
VITE_SITE_URL=

# SERVER ONLY — never prefix with VITE_
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# Stripe checkout server (server/index.ts). Test-mode keys work in development;
# use live keys + a real webhook endpoint for production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
API_PORT=8787

# Rate limits (requests per minute, in-memory per key). Defaults shown.
RATE_LIMIT_CHECKOUT_IP=15
RATE_LIMIT_CHECKOUT_USER=30
RATE_LIMIT_WEBHOOK_IP=120
RATE_LIMIT_STATUS_IP=60

# Transactional email (server/index.ts via Resend). Emails are skipped with a log
# line when RESEND_API_KEY is absent. MAIL_FROM must be a verified Resend domain.
RESEND_API_KEY=
MAIL_FROM=FÉROCE FASHION_FF <orders@feroce.example>
RESEND_API_URL=https://api.resend.com

APP_URL=http://localhost:5173
